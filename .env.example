# Development configuration for programmers.
# For a real installation, use one of these templates instead:
#   deployment/config/local.env.example
#   deployment/config/hosting.env.example
# The private .env file is ignored by Git and must never be committed.
BIOCLEAN_ENV=dev
BIOCLEAN_SECRET_KEY=replace-with-a-long-random-secret-key
BIOCLEAN_CSRF_TRUSTED_ORIGINS=https://*.app.bioclean.ru

BIOCLEAN_DATABASE_ENGINE=mysql
BIOCLEAN_DATABASE_NAME=bioclean_local
BIOCLEAN_DATABASE_USER=bioclean_app
BIOCLEAN_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_DATABASE_HOST=localhost
BIOCLEAN_DATABASE_PORT=3306

# Central organization registry.
BIOCLEAN_PLATFORM_DATABASE_ENGINE=mysql
BIOCLEAN_PLATFORM_DATABASE_NAME=bioclean_platform
BIOCLEAN_PLATFORM_DATABASE_USER=bioclean_app
BIOCLEAN_PLATFORM_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_PLATFORM_DATABASE_HOST=localhost
BIOCLEAN_PLATFORM_DATABASE_PORT=3306

# Use the same hostname-based organization selection in development.
BIOCLEAN_MULTI_TENANT=1

# Database backups. Use an absolute path in production.
BIOCLEAN_BACKUP_DIR=F:\app\ot\backups\databases
BIOCLEAN_BACKUP_RETENTION_DAYS=31
# BIOCLEAN_MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# Optional: separate credentials for an organization when the hosting creates
# a different MySQL user for every database. FIRST uses the default connection
# above; add a block like this for each subsequent organization slug.
# BIOCLEAN_ORGANIZATION_CLIENT2_DATABASE_USER=hosting_client2
# BIOCLEAN_ORGANIZATION_CLIENT2_DATABASE_PASSWORD=replace-with-client-password
# BIOCLEAN_ORGANIZATION_CLIENT2_DATABASE_HOST=localhost
# BIOCLEAN_ORGANIZATION_CLIENT2_DATABASE_PORT=3306
