# Private local configuration. Copy this file to .env and set your own password.
# The .env file is ignored by Git and must never be sent with a release.
BIOCLEAN_DATABASE_ENGINE=mysql
BIOCLEAN_DATABASE_NAME=bioclean_local
BIOCLEAN_DATABASE_USER=bioclean_app
BIOCLEAN_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_DATABASE_HOST=localhost
BIOCLEAN_DATABASE_PORT=3306

# Central SaaS platform database. Use the same MySQL account for local setup.
BIOCLEAN_PLATFORM_DATABASE_ENGINE=mysql
BIOCLEAN_PLATFORM_DATABASE_NAME=bioclean_platform
BIOCLEAN_PLATFORM_DATABASE_USER=bioclean_app
BIOCLEAN_PLATFORM_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_PLATFORM_DATABASE_HOST=localhost
BIOCLEAN_PLATFORM_DATABASE_PORT=3306
