# Hosted SaaS installation. Copy to <application>/.env and keep private.
BIOCLEAN_ENV=prod
BIOCLEAN_SECRET_KEY=replace-with-a-long-random-secret-key
BIOCLEAN_CSRF_TRUSTED_ORIGINS=https://*.app.example.ru

# Default organization database connection template.
BIOCLEAN_DATABASE_ENGINE=mysql
BIOCLEAN_DATABASE_NAME=hosting_first
BIOCLEAN_DATABASE_USER=hosting_first
BIOCLEAN_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_DATABASE_HOST=localhost
BIOCLEAN_DATABASE_PORT=3306

# Central organization registry.
BIOCLEAN_PLATFORM_DATABASE_ENGINE=mysql
BIOCLEAN_PLATFORM_DATABASE_NAME=hosting_platform
BIOCLEAN_PLATFORM_DATABASE_USER=hosting_platform
BIOCLEAN_PLATFORM_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_PLATFORM_DATABASE_HOST=localhost
BIOCLEAN_PLATFORM_DATABASE_PORT=3306

BIOCLEAN_MULTI_TENANT=1

# Daily database backups.
BIOCLEAN_BACKUP_DIR=/home/LOGIN/app.bioclean.ru/backups/databases
BIOCLEAN_BACKUP_RETENTION_DAYS=31
# BIOCLEAN_MYSQLDUMP_PATH=/usr/bin/mysqldump

# Add one credential block for every organization whose database has a
# separate MySQL user. CLIENT_SLUG is the uppercase organization slug with
# hyphens replaced by underscores.
# BIOCLEAN_ORGANIZATION_CLIENT_SLUG_DATABASE_USER=hosting_client
# BIOCLEAN_ORGANIZATION_CLIENT_SLUG_DATABASE_PASSWORD=replace-with-client-password
# BIOCLEAN_ORGANIZATION_CLIENT_SLUG_DATABASE_HOST=localhost
# BIOCLEAN_ORGANIZATION_CLIENT_SLUG_DATABASE_PORT=3306
