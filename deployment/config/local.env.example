# Local production installation. Copy to <application>/.env and keep private.
BIOCLEAN_ENV=local
BIOCLEAN_SECRET_KEY=replace-with-a-long-random-secret-key

# Addresses used to open the application inside the local network.
# The server should have a static IP address.
BIOCLEAN_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
BIOCLEAN_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.10:8000

# Organization database. The same MySQL account may own both local databases.
BIOCLEAN_DATABASE_ENGINE=mysql
BIOCLEAN_DATABASE_NAME=bioclean_client
BIOCLEAN_DATABASE_USER=bioclean_app
BIOCLEAN_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_DATABASE_HOST=localhost
BIOCLEAN_DATABASE_PORT=3306

# Central organization registry.
BIOCLEAN_PLATFORM_DATABASE_ENGINE=mysql
BIOCLEAN_PLATFORM_DATABASE_NAME=bioclean_platform
BIOCLEAN_PLATFORM_DATABASE_USER=bioclean_app
BIOCLEAN_PLATFORM_DATABASE_PASSWORD=replace-with-your-password
BIOCLEAN_PLATFORM_DATABASE_HOST=localhost
BIOCLEAN_PLATFORM_DATABASE_PORT=3306

# Local and hosted installations use the same organization isolation mechanism.
BIOCLEAN_MULTI_TENANT=1

# Daily database backups.
BIOCLEAN_BACKUP_DIR=C:\Bioclean\backups\databases
BIOCLEAN_BACKUP_RETENTION_DAYS=31
# BIOCLEAN_MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# Waitress listener for the local network.
BIOCLEAN_BIND_HOST=0.0.0.0
BIOCLEAN_BIND_PORT=8000
